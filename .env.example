# Public site URL (used in links)
NEXT_PUBLIC_SITE_URL=
# Supabase (region ap-south-1 Mumbai recommended)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=
# Email. EMAIL_PROVIDER = gmail | resend (optional; if unset, Gmail is used when GMAIL_USER and GMAIL_APP_PASSWORD are set, else Resend)
EMAIL_PROVIDER=
# Gmail SMTP: a Gmail account dedicated to the drive, and a 16-character app password (needs 2-Step Verification). Never the normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name shown as the sender (optional; defaults to NEXT_PUBLIC_ORG_NAME)
GMAIL_FROM_NAME=
# Resend (fallback). e.g. Alzahraa Blood Drive <noreply@mail.example.org> (must be on a verified domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Max emails per rolling 24h. Leave empty for the provider default: Gmail 450 (Gmail allows about 500), Resend 95 (free plan 100)
EMAIL_DAILY_BUDGET=
# Discord webhook for error alerts (no personal data is ever sent). SERVER ONLY.
DISCORD_WEBHOOK_URL=
# Cloudflare Turnstile. Test keys for local dev:
#   site 1x00000000000000000000AA (always passes), 2x00000000000000000000AB (always blocks)
#   secret 1x0000000000000000000000000000000AA (always passes), 2x0000000000000000000000000000000AA (always fails)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random 32+ chars; Vercel sends it as a Bearer token to the cron route
CRON_SECRET=
# Random 32+ chars; salts IP hashes for rate limiting
RATE_LIMIT_SALT=
# Shown on the privacy page, PDF and email
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_ORG_CONTACT_EMAIL=
NEXT_PUBLIC_ORG_CONTACT_PHONE=
